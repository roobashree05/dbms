# Database Configuration
DATABASE_URL="postgresql://aijewel:aijewel123@localhost:5432/aijewel_crm"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT & Security
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="24h"

# Application
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3001"

# Demo Mode - Run with all mock providers
DEMO_MODE=true

# External Service Providers
WHATSAPP_PROVIDER="mock"
META_PROVIDER="mock"
VOICE_PROVIDER="mock"
CALENDAR_PROVIDER="mock"
AI_PROVIDER="mock"
FILE_STORAGE_PROVIDER="local"

# File Upload
UPLOAD_DIRECTORY="./uploads"
MAX_FILE_SIZE="52428800"

# Logging
LOG_LEVEL="debug"

# Optional: Real Provider Credentials (leave empty for mock mode)
WHATSAPP_BUSINESS_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
HUBSPOT_API_KEY=""
ZOHO_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
